<?xml version="1.0" encoding="utf-8" ?>

<Page
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d"
    x:Class="Audibly.App.Views.LibraryCardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:Audibly.App.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Audibly.Models"
    xmlns:userControls="using:Audibly.App.UserControls"
    xmlns:viewModels="using:Audibly.App.ViewModels"
    xmlns:views="using:Audibly.App.Views"
    xmlns:winUi="using:CommunityToolkit.WinUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="LibraryCardPage_DragOver"
    Drop="LibraryCardPage_Drop">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <DataTemplate x:DataType="viewModels:AudiobookViewModel" x:Key="AudiobookTemplate">
            <userControls:AudiobookTile
                Author="{x:Bind Author, Mode=OneWay}"
                ChapterCount="{x:Bind Chapters.Count, Mode=OneWay}"
                Duration="{x:Bind Duration, Mode=OneWay}"
                FilePath="{x:Bind CurrentSourceFile.FilePath, Mode=OneWay}"
                Id="{x:Bind Id, Mode=OneWay}"
                IsCompleted="{x:Bind IsCompleted, Mode=OneWay}"
                IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                Progress="{x:Bind Progress, Mode=OneWay}"
                SourcePaths="{x:Bind SourcePaths, Mode=OneWay}"
                SourcePathsCount="{x:Bind SourcePaths.Count, Mode=OneWay}"
                Title="{x:Bind Title, Mode=OneWay}">
                <userControls:AudiobookTile.Source>
                    <Image Source="{x:Bind ThumbnailPath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                </userControls:AudiobookTile.Source>
            </userControls:AudiobookTile>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Invoked="DebugMenuKeyboardAccelerator_OnInvoked"
            Key="F12"
            Modifiers="Control,Shift" />
    </Page.KeyboardAccelerators>

    <RelativePanel Padding="36,36,48,0" x:Name="LayoutRoot">
        <!--  start panel (shown when no audiobooks have been imported yet)  -->
        <StackPanel
            Orientation="Vertical"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.AlignVerticalCenterWithPanel="True"
            Visibility="{x:Bind ViewModel.ShowStartPanel, Mode=OneWay}"
            x:Name="StartPanel">

            <TextBlock
                FontSize="36"
                Margin="0,0,0,16"
                Opacity="0.8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Audibly"
                TextAlignment="Left" />

            <TextBlock
                FontSize="24"
                Margin="0,0,0,8"
                Opacity="0.6"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Start"
                TextAlignment="Left" />

            <userControls:CustomHyperlinkButton
                ButtonClick="{x:Bind ViewModel.ImportAudiobookAsync}"
                Icon="&#xE8E5;"
                Text="{x:Bind views:LibraryCardPage.ImportAudiobookText}" />

            <userControls:CustomHyperlinkButton
                ButtonClick="{x:Bind ViewModel.ImportAudiobooksFromDirectoryAsync}"
                Icon="&#xED25;"
                Text="{x:Bind views:LibraryCardPage.ImportAudiobooksFromDirectoryText}" />

            <userControls:CustomHyperlinkButton
                ButtonClick="{x:Bind ViewModel.ImportAudiobookWithMultipleFilesAsync}"
                Icon="&#xE838;"
                Text="{x:Bind views:LibraryCardPage.ImportAudiobookWithMultipleFilesText}" />

            <userControls:CustomHyperlinkButton
                ButtonClick="{x:Bind ViewModel.ImportFromUserSelectedJsonFileAsync}"
                Icon="&#xE896;"
                Text="{x:Bind views:LibraryCardPage.ImportFromJsonFileText}" />

        </StackPanel>

        <!--  title and command bar  -->
        <StackPanel
            HorizontalAlignment="Stretch"
            Orientation="Vertical"
            RelativePanel.AlignLeftWithPanel="True"
            RelativePanel.AlignRightWithPanel="True"
            x:Name="TitleAndCommandBarPanel">
            <TextBlock
                Margin="20,8,6,0"
                Style="{StaticResource PageTitleTextBlockStyle}"
                Text="Audiobook Library"
                x:Name="PageTitle" />
            
            <Grid Margin="4,0,0,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Left buttons -->
                    <ColumnDefinition Width="*" />
                    <!-- Elastic search -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Right buttons -->
                </Grid.ColumnDefinitions>

                <!-- Left-aligned buttons: Sort, Status, Length -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">

                    <!-- Sort button -->
                    <AppBarButton
                        Icon="Sort"
                        Label="Sort"
                        ToolTipService.ToolTip="Sort Audiobooks"
                        x:Name="SortButton">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem
                                    x:Name="SortAlphabeticalItem"
                                    Click="SortAlphabetical_OnClick"
                                    IsChecked="True"
                                    Text="Alphabetical" />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortByDateImportedItem"
                                    Click="SortByDateImported_OnClick"
                                    Text="Date imported" />
                                <ToggleMenuFlyoutItem
                                    x:Name="SortByLastPlayedItem"
                                    Click="SortByLastPlayed_OnClick"
                                    Text="Last played" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <!-- Status (progress filter) button -->
                    <AppBarButton
                        Label="Status"
                        ToolTipService.ToolTip="Filter by Status"
                        x:Name="FilterButton">
                        <Grid Width="40">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71C;" FontSize="20" HorizontalAlignment="Center" />
                            <Ellipse
                                x:Name="StatusFilterDot"
                                Width="8" Height="8"
                                Fill="Red"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="Collapsed" />
                        </Grid>
                        <AppBarButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Orientation="Vertical" Spacing="2">
                                    <HyperlinkButton
                                        Click="ResetStatusFilters_OnClick"
                                        Content="Reset"
                                        Padding="0,2,0,4"
                                        x:Name="ResetStatusLink" />
                                    <CheckBox
                                        Checked="StatusFilterCheckBox_OnToggled"
                                        Content="Not Started"
                                        Unchecked="StatusFilterCheckBox_OnToggled"
                                        x:Name="NotStartedFilterCheckBox" />
                                    <CheckBox
                                        Checked="StatusFilterCheckBox_OnToggled"
                                        Content="In Progress"
                                        Unchecked="StatusFilterCheckBox_OnToggled"
                                        x:Name="InProgressFilterCheckBox" />
                                    <CheckBox
                                        Checked="StatusFilterCheckBox_OnToggled"
                                        Content="Completed"
                                        Unchecked="StatusFilterCheckBox_OnToggled"
                                        x:Name="CompletedFilterCheckBox" />
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <!-- Length filter button -->
                    <AppBarButton
                        Label="Length"
                        ToolTipService.ToolTip="Filter by Length"
                        x:Name="LengthButton">
                        <Grid Width="40">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE823;" FontSize="20" HorizontalAlignment="Center" />
                            <Ellipse
                                x:Name="LengthFilterDot"
                                Width="8" Height="8"
                                Fill="Red"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="Collapsed" />
                        </Grid>
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem
                                    x:Name="LengthAnyItem"
                                    Click="LengthAny_OnClick"
                                    IsChecked="True"
                                    Text="Any Length" />
                                <ToggleMenuFlyoutItem
                                    x:Name="LengthShortItem"
                                    Click="LengthShort_OnClick"
                                    Text="Short (&lt; 6h)" />
                                <ToggleMenuFlyoutItem
                                    x:Name="LengthMediumItem"
                                    Click="LengthMedium_OnClick"
                                    Text="Medium (6h – 17h)" />
                                <ToggleMenuFlyoutItem
                                    x:Name="LengthLongItem"
                                    Click="LengthLong_OnClick"
                                    Text="Long (&gt; 17h)" />
                                <ToggleMenuFlyoutItem
                                    x:Name="LengthCustomItem"
                                    Click="LengthCustom_OnClick"
                                    Text="Custom…" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarSeparator />
                </StackPanel>

                <!-- Elastic search / tag token box -->
                <controls:TokenizingTextBox
                    Grid.Column="1"
                    x:Name="AudiobookSearchBox"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="8,0,8,0"
                    MinWidth="200"
                    MaxHeight="80"
                    PlaceholderText="Search or select tags from sidebar"
                    TokenDelimiter=""
                    ItemsSource="{x:Bind ViewModel.SelectedTags}"
                    TextMemberPath="Name"
                    TextChanged="AudiobookSearchBox_TextChanged"
                    QuerySubmitted="AudiobookSearchBox_QuerySubmitted"
                    TokenItemAdding="AudiobookSearchBox_TokenItemAdding"
                    TokenItemAdded="AudiobookSearchBox_TokenItemAdded"
                    TokenItemRemoved="AudiobookSearchBox_TokenItemRemoved">
                    <controls:TokenizingTextBox.QueryIcon>
                        <SymbolIconSource Symbol="Find" />
                    </controls:TokenizingTextBox.QueryIcon>
                    <controls:TokenizingTextBox.TokenItemTemplate>
                        <DataTemplate x:DataType="models:Tag">
                            <TextBlock Text="{x:Bind Name}" />
                        </DataTemplate>
                    </controls:TokenizingTextBox.TokenItemTemplate>
                </controls:TokenizingTextBox>

                <!-- Right-aligned buttons: Import, Refresh, Zoom -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                    <AppBarSeparator />

                    <AppBarButton
                        Icon="Download"
                        Label="Import"
                        ToolTipService.ToolTip="Import audiobooks">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE838;" />
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    Click="{x:Bind ViewModel.ImportAudiobookAsync}"
                                    Icon="OpenFile"
                                    Text="{x:Bind views:LibraryCardPage.ImportAudiobookText}" />
                                <MenuFlyoutItem
                                    Click="{x:Bind ViewModel.ImportAudiobooksFromDirectoryAsync}"
                                    Icon="Folder"
                                    Text="{x:Bind views:LibraryCardPage.ImportAudiobooksFromDirectoryText}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="{x:Bind ViewModel.ImportAudiobookWithMultipleFilesAsync}" Text="{x:Bind views:LibraryCardPage.ImportAudiobookWithMultipleFilesText}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Click="{x:Bind ViewModel.ImportFromUserSelectedJsonFileAsync}"
                                    Icon="Download"
                                    Text="{x:Bind views:LibraryCardPage.ImportFromJsonFileText}" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        Click="{x:Bind RefreshButton_OnClick}"
                        Icon="Refresh"
                        Label="Refresh"
                        ToolTipService.ToolTip="Refresh audiobooks" />

                    <AppBarButton
                        Icon="Zoom"
                        Label="Zoom"
                        ToolTipService.ToolTip="Zoom"
                        x:Name="ZoomButton">
                        <AppBarButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" x:Name="ZoomFlyout">
                                <userControls:ZoomLevelUserControl
                                    ZoomInButtonIsEnabled="{x:Bind ViewModel.ZoomInButtonIsEnabled, Mode=OneWay}"
                                    ZoomOutButtonIsEnabled="{x:Bind ViewModel.ZoomOutButtonIsEnabled, Mode=OneWay}"
                                    x:Name="ZoomLevelUserControl" />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <!--  region: debug menu  -->
                    <AppBarSeparator Visibility="{x:Bind ViewModel.ShowDebugMenu, Mode=OneWay}" x:Name="DebugMenuSeparator" />

                    <AppBarButton
                        Label="Debug Menu"
                        ToolTipService.ToolTip="Debug Menu"
                        Visibility="{x:Bind ViewModel.ShowDebugMenu, Mode=OneWay}">
                        <AppBarButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem
                                    Icon="AlignCenter"
                                    IsChecked="{x:Bind ViewModel.ShowAlignmentGrids, Mode=TwoWay}"
                                    Text="Show Alignment Grid"
                                    ToolTipService.ToolTip="Show Alignment Grid" />
                                <ToggleMenuFlyoutItem
                                    Icon="Refresh"
                                    IsChecked="{x:Bind ViewModel.IsLoading, Mode=TwoWay}"
                                    Text="Toggle Loading Progress Bar"
                                    ToolTipService.ToolTip="Toggle Loading Progress Bar" />
                                <MenuFlyoutItem
                                    Click="{x:Bind ViewModel.DeleteAudiobooksAsync}"
                                    Icon="Delete"
                                    Text="Delete All"
                                    ToolTipService.ToolTip="Delete all audiobooks" />
                                <MenuFlyoutItem
                                    Click="{x:Bind ViewModel.MigrateDatabase}"
                                    Icon="Sync"
                                    Text="Test Data Migration"
                                    ToolTipService.ToolTip="Test Data Migration" />
                                <MenuFlyoutItem
                                    Click="{x:Bind OpenAppStateFolderButton_OnClick}"
                                    Text="Open App State Folder"
                                    ToolTipService.ToolTip="Open App State Folder">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xED25;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="{x:Bind OpenCurrentAudiobooksAppStateFolder_OnClick}"
                                    Text="Open Audiobook App State Folder"
                                    ToolTipService.ToolTip="Open Current Audiobooks App State Folder">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xED25;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="{x:Bind TestContentDialogButton_OnClick}"
                                    Text="Test Content Dialog"
                                    ToolTipService.ToolTip="Test Content Dialog">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8FF;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="{x:Bind TestNotificationButton_OnClick}"
                                    Text="Test Notification"
                                    ToolTipService.ToolTip="Test Notification">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="{x:Bind ThrowExceptionButton_OnClick}"
                                    Text="Throw Exception"
                                    ToolTipService.ToolTip="Throw Exception">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE783;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="{x:Bind TestSentryLoggingButton_OnClick}"
                                    Text="Test Sentry Logging"
                                    ToolTipService.ToolTip="Test Sentry Logging">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE783;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="{x:Bind RestartAppButton_OnClick}"
                                    Text="Restart App"
                                    ToolTipService.ToolTip="Restart App">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xF83E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="{x:Bind HideNowPlayingBarButton_OnClick}"
                                    Text="Hide Now Playing Bar"
                                    ToolTipService.ToolTip="Hide Now Playing Bar">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE71A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEBE8;" />
                    </AppBarButton>
                    <!--  endregion: debug menu  -->
                </StackPanel>
            </Grid>
        </StackPanel>

        <!--  multi-select action bar: appears when 2+ tiles are selected  -->
        <StackPanel
            x:Name="MultiSelectActionBar"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            RelativePanel.AlignLeftWithPanel="True"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.Below="TitleAndCommandBarPanel"
            Spacing="8"
            Padding="0,4,0,2"
            Visibility="{x:Bind ViewModel.HasMultipleSelected, Mode=OneWay}">
            <HyperlinkButton Click="MultiSelectDeleteSelected_OnClick" Padding="8,4"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="Delete selected" VerticalAlignment="Center" />
                </StackPanel>
            </HyperlinkButton>
            <HyperlinkButton Click="MultiSelectManageTags_OnClick" Padding="8,4"
                             Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8EC;" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="Manage tags" VerticalAlignment="Center" />
                </StackPanel>
            </HyperlinkButton>
        </StackPanel>

        <!--  library card view  -->
        <ScrollViewer
            IsVerticalScrollChainingEnabled="False"
            Padding="0,8,0,8"
            RelativePanel.AlignBottomWithPanel="True"
            RelativePanel.AlignLeftWithPanel="True"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.Below="MultiSelectActionBar"
            x:Name="LibraryCardScrollView">
            <StackPanel Orientation="Vertical">
                <ItemsRepeater
                    ItemTemplate="{StaticResource AudiobookTemplate}"
                    ItemsSource="{x:Bind ViewModel.Audiobooks, Mode=OneWay}"
                    x:Name="LibraryCardView">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Start"
                            ItemsStretch="Uniform"
                            MinColumnSpacing="4"
                            MinRowSpacing="6" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <Rectangle Height="200" Opacity="0" />
            </StackPanel>
        </ScrollViewer>

        <!--  progress bar for when library view is loading  -->
        <userControls:ProgressBarCard
            Canvas.ZIndex="10"
            IsIndeterminate="True"
            Margin="25,0,50,0"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            RelativePanel.AlignLeftWithPanel="True"
            RelativePanel.AlignRightWithPanel="True"
            RelativePanel.AlignVerticalCenterWithPanel="True"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LibraryCardViewVisibility">
                <!--  when no audiobooks have been imported yet  -->
                <VisualState x:Name="NoAudiobooksState">
                    <VisualState.StateTriggers>
                        <winUi:IsEqualStateTrigger To="true" Value="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        <winUi:IsNullOrEmptyStateTrigger Value="{x:Bind ViewModel.Audiobooks, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LibraryCardScrollView.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </RelativePanel>
</Page>