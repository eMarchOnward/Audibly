<!--  ReSharper disable once Xaml.InvalidResourceType  -->
<Page
    x:Class="Audibly.App.AppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Audibly.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:userControls="using:Audibly.App.UserControls"
    xmlns:viewModels="using:Audibly.App.ViewModels"
    xmlns:winUi="using:CommunityToolkit.WinUI"
    Background="{ThemeResource AppShellBackgroundBrush}"
    Loaded="AppShell_OnLoaded"
    TabNavigation="Cycle"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <!--  TitleBar  -->
            <RowDefinition Height="*" />
            <!--  NavView  -->
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Grid.Column="1"
            Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
            Margin="48,0,0,0"
            VerticalAlignment="Stretch"
            AutomationProperties.AutomationId="AppTitleBar"
            Canvas.ZIndex="1"
            IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="24" Source="ms-appx:///Assets/logo.png" />
                <TextBlock
                    x:Name="AppTitle"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Audibly" />
            </StackPanel>
        </Border>

        <muxc:NavigationView
            x:Name="NavView"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            AlwaysShowHeader="False"
            BackRequested="NavigationView_BackRequested"
            Canvas.ZIndex="0"
            DisplayModeChanged="NavView_DisplayModeChanged"
            IsBackEnabled="{x:Bind AppAppShellFrame.CanGoBack, Mode=OneWay}"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="True"
            ItemInvoked="NavigationView_ItemInvoked"
            OpenPaneLength="210"
            Visibility="{x:Bind ViewModel.IsNavigationViewVisible, Mode=OneWay}">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem
                    x:Name="LibraryCardMenuItem"
                    Content="{x:Bind LibraryLabel}"
                    Tag="LibraryPage"
                    ToolTipService.ToolTip="{x:Bind LibraryLabel}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE736;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem
                    x:Name="NowPlayingMenuItem"
                    Content="{x:Bind NowPlayingLabel}"
                    Tag="NowPlayingPage"
                    ToolTipService.ToolTip="{x:Bind NowPlayingLabel}">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem
                    SelectsOnInvoked="False"
                    Padding="0"
                    Margin="0"
                    HorizontalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.HasAnySelected, Mode=OneWay}">
                    <muxc:NavigationViewItem.Content>
                        <!--  Gated on the pane being open (not just something being selected), so it's
                              hidden while collapsed and only appears once the pane is expanded.  -->
                        <ScrollViewer
                            MaxHeight="420"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto"
                            Visibility="{x:Bind viewModels:Converters.CollapsedIfNot(ViewModel.HasAnySelected, NavView.IsPaneOpen), Mode=OneWay}">
                            <StackPanel Margin="-20,0,-20,0" HorizontalAlignment="Stretch" Padding="20,8,20,8" Spacing="16">

                        <!--  One book selected  -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasSingleSelected, Mode=OneWay}">

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="4">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind ViewModel.SingleSelectedAudiobook.ThumbnailPath, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{x:Bind ViewModel.SingleSelectedAudiobook.Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Opacity="0.7"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.SingleSelectedAudiobook.Author, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="FORMAT" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.SingleSelectedAudiobook.FormatDisplayText, Mode=OneWay}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="DATE ADDED" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.SingleSelectedAudiobook.DateAddedDisplayText, Mode=OneWay}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="LAST PLAYED" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.SingleSelectedAudiobook.LastPlayedDisplayText, Mode=OneWay}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="CHAPTERS" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.SingleSelectedAudiobook.Chapters.Count, Mode=OneWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="BOOKMARKS" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.SingleSelectedAudiobook.Model.Bookmarks.Count, Mode=OneWay}" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="TAGS" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SingleSelectedAudiobook.Model.Tags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Tag">
                                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                                <TextBlock FontSize="12" Text="{x:Bind Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Button
                                Click="DetailsEditBookButton_OnClick"
                                Content="Edit Book Details"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                            <Button
                                Click="DetailsShowInFileExplorerButton_OnClick"
                                Content="Show in File Explorer"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <!--  Multiple books selected  -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasMultipleSelected, Mode=OneWay}">

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE736;" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                                <TextBlock FontWeight="SemiBold" Text="Books Selected" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="TOTAL LENGTH" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.SelectedTotalLengthText, Mode=OneWay}" />
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="FORMATS" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.SelectedFormatsBreakdownText, Mode=OneWay}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="SHARED TAGS" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSharedTags, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="4" VerticalSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Tag">
                                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="10" Padding="8,2">
                                                <TextBlock FontSize="12" Text="{x:Bind Name}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <HyperlinkButton Click="DetailsManageTagsButton_OnClick" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE8EC;" VerticalAlignment="Center" />
                                    <TextBlock Text="Manage Tags" VerticalAlignment="Center" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Click="DetailsDeleteSelectedButton_OnClick" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE74D;" VerticalAlignment="Center" />
                                    <TextBlock Text="Delete Selected" VerticalAlignment="Center" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </muxc:NavigationViewItem.Content>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <muxc:NavigationView.PaneFooter>
                <StackPanel>
                    <muxc:NavigationViewItem
                        Content="View code"
                        Tapped="ViewCodeNavPaneButton_Tapped"
                        ToolTipService.ToolTip="View code">
                        <muxc:NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE943;" />
                        </muxc:NavigationViewItem.Icon>
                    </muxc:NavigationViewItem>
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <!--  Content  -->
            <RelativePanel>
                <!--  In OnNavigatingToPage, we synchronize the selected item in the NavigationView with the current page.  -->
                <Frame
                    x:Name="AppShellFrame"
                    Margin="12,0,0,0"
                    Navigating="OnNavigatingToPage"
                    RelativePanel.AlignBottomWithPanel="True"
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True"
                    RelativePanel.AlignTopWithPanel="True">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>

                <!--  player  -->
                <Grid
                    x:Name="Player"
                    MaxHeight="250"
                    Margin="12,0,12,12"
                    Padding="12,8"
                    Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="2"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    RelativePanel.AlignBottomWithPanel="True"
                    RelativePanel.AlignLeftWithPanel="True"
                    RelativePanel.AlignRightWithPanel="True">

                    <!-- Named so the shell can call Increase/Decrease/Reset -->
                    <userControls:PlayerControlGrid x:Name="PlayerControl" />

                </Grid>

                <!--  notifications  -->
                <ScrollViewer
                    Margin="0,0,12,12"
                    Canvas.ZIndex="2"
                    RelativePanel.Above="Player"
                    RelativePanel.AlignRightWithPanel="True">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:Notification">
                                    <Grid>
                                        <InfoBar
                                            HorizontalAlignment="Right"
                                            Closed="InfoBar_OnClosed"
                                            IsClosable="True"
                                            IsIconVisible="True"
                                            IsOpen="True"
                                            Message="{x:Bind Message}"
                                            Severity="{x:Bind Severity}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </RelativePanel>

        </muxc:NavigationView>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PlayerVisibility">
                <!--  when no audiobooks have been imported yet  -->
                <VisualState x:Name="PlayerStateCollapsed">
                    <VisualState.StateTriggers>
                        <winUi:IsNullOrEmptyStateTrigger Value="{x:Bind PlayerViewModel.NowPlaying, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NowPlayingMenuItem.Visibility" Value="Collapsed" />
                        <Setter Target="Player.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="TitleBarStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="AppTitleBar.Margin" Value="96,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WindowActivationStates">
                <VisualState x:Name="Activated" />
                <VisualState x:Name="Deactivated">
                    <VisualState.Setters>
                        <Setter Target="AppTitle.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>